# ── Serveur ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── PostgreSQL ─────────────────────────────────────────────
PGUSER=notes_user
PGPASSWORD=change_moi
PGHOST=localhost
PGPORT=5432
PGDATABASE=notes_db

# ── JWT ────────────────────────────────────────────────────
# Générer une valeur forte, ex: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_moi_avec_une_valeur_longue_et_aleatoire
JWT_EXPIRES_IN=7d

# ── CORS ───────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
